# ---- Database (MySQL 8) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=ledger
DB_PASSWORD=change-me
DB_NAME=sales_ledger

# ---- Auth ----
JWT_SECRET=change-me-long-random

# ---- Server ----
PORT=8090

# ---- Production only ----
# Comma-separated list of allowed frontend origins for CORS + Socket.IO.
# Leave unset for local dev (allows all).
# CORS_ORIGIN=https://your-app.vercel.app

# Persistent volume path for WhatsApp auth + media. Set this to a mounted disk
# (Railway volume, Render disk) so sessions survive restarts. Defaults to the
# backend folder when unset.
# DATA_DIR=/data

# Set to "false" when the frontend is hosted separately (Vercel) and this
# process should ONLY serve the API. Leave unset for a single-server deploy
# where the backend also serves frontend/dist.
# SERVE_CLIENT=false
